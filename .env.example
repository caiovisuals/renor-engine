# Copy to .env for local development
# Required
VAULT_PATH=/path/to/your/vault

# Optional
# eval-hash: deterministic offline smoke embeddings; no download/key, not semantic search quality.
EMBEDDING_PROVIDER=eval-hash
# openai (the unset default): semantic embeddings via API; requires OPENAI_API_KEY.
# local: downloads and runs a model on this machine; no API key.
# EMBEDDING_MODEL=text-embedding-3-small
# HTTP server: MVP_EMBEDDING_PROVIDER=none disables embeddings for keyword-only smoke runs.
# OPENAI_API_KEY=sk-...
# DB_PATH=/path/to/your/vault/.semantic-memory/index.db
# MEMORY_DIR=Memory/Daily
# CONVERSATIONS_DIR=Claude Code/Conversations
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP_TOKENS=50
# PRIORITY_PATHS=Projects/,Areas/Work/
# LLM_EXTRACTION=false
# INDEX_CONCURRENCY=5


# Optional production observability (metadata only; never memory/query content)
# Shared project API key (phc_…) for custom renor_* events AND @posthog/mcp Analytics.
# Do not commit real values. If unset / RENOR_TELEMETRY_DISABLED=true,
# MCP Analytics instrumentation is skipped (no crash).
# RENOR_POSTHOG_KEY=phc_...
# RENOR_POSTHOG_HOST=https://us.i.posthog.com
# RENOR_POSTHOG_CAPTURE_URL=https://us.i.posthog.com/i/v0/e/
# RENOR_SENTRY_DSN=https://PUBLIC_KEY@REGION.ingest.sentry.io/PROJECT_ID
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# RENOR_TELEMETRY_HASH_SALT=replace-with-random-deployment-secret
# RENOR_TELEMETRY_TIMEOUT_MS=1500
# RENOR_TELEMETRY_DISABLED=false
