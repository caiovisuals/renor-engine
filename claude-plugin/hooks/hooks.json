{
  "description": "Renor handoff note (default off: set RENOR_HANDOFF_NOTE=1). SessionStart shows this repo and branch's note; Stop asks the agent to overwrite it.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff.mjs\" session-start", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff.mjs\" stop", "timeout": 10 }
        ]
      }
    ]
  }
}
